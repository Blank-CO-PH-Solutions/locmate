# Copy to supabase/.env (gitignored) and fill in. Used by `supabase config push`
# and `supabase secrets set --env-file supabase/.env`.

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
# Authorized redirect URI: https://radrullnoovvllikabmw.supabase.co/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# RevenueCat → Project settings → Integrations → Webhooks → Authorization header value
REVENUECAT_WEBHOOK_SECRET=
