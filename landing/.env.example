# Copy to landing/.env for local development, or set these in the Render
# dashboard. Never commit real keys.

# Public URL of the deployed site. Used for PayMongo success/cancel URLs.
# On Render set this to https://<your-service>.onrender.com (or a custom domain).
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# Supabase project (the landing page only uses the service role server-side).
SUPABASE_URL=https://radrullnoovvllikabmw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# PayMongo → Settings → Developers → API keys.
# Leave PAYMONGO_SECRET_KEY empty to keep the site live but disable purchases.
PAYMONGO_SECRET_KEY=
# PayMongo → Developers → Webhooks → the endpoint you create for
# https://<your-service>.onrender.com/webhooks/paymongo
PAYMONGO_WEBHOOK_SECRET=

# Comma-separated payment methods offered on the hosted checkout.
# Only enable methods that are active on your PayMongo account.
PAYMONGO_PAYMENT_METHODS=card,gcash,paymaya,qrph

# Prices are in centavos (₱99.00 = 9900).
PREMIUM_MONTHLY_AMOUNT=9900
PREMIUM_ANNUAL_AMOUNT=99900

# Public URL of the APK, for example a Supabase Storage public URL or a
# GitHub release asset. Leave empty until the build is uploaded.
APK_URL=
APK_SHA256=
APK_VERSION=1.0.0
